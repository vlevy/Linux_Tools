#!/bin/bash
# Block an IP or CIDR unless it overlaps loopback, the allowlist, or official Googlebot prefixes.
# Allowlist ($ALLOWLIST_FILE): one IP, CIDR, or rDNS glob (e.g. *.example.com) per line, # comments.
# List current blocks, unblock ranges, and autoblock high-rate offenders.
# Requires: curl, python3, iptables/ip6tables. Uses netfilter-persistent if present.
# Manual blocks affect all services; autoblock defaults to TCP ports 80 and 443.

set -euo pipefail

BLOCK_IP_START_SECONDS=$SECONDS
TMP_JSON=""
finish() {
  local status=$? elapsed=$((SECONDS - BLOCK_IP_START_SECONDS))
  if [ -n "${TMP_JSON:-}" ]; then
    rm -f -- "$TMP_JSON" || true
  fi
  printf 'Elapsed time: %dm %ds\n' "$((elapsed / 60))" "$((elapsed % 60))"
  exit "$status"
}
trap finish EXIT

USAGE="Usage:
  $0 <IP or CIDR>                  Block the address range unless it is protected
  $0 --list [4|6]                  List source DROP rules on INPUT, with their scope
  $0 --unblock <CIDR...>           Remove one or more blocked ranges
  $0 --autoblock <minutes> <N>     Block IPs with >= N requests in the last <minutes>
       [--dry-run] [--log <path>] [--all-ports]
  $0 --help                       Show this help

Manual blocks affect ALL services, including SSH and databases.
Autoblock affects TCP 80/443; --all-ports explicitly selects all services.
Existing whole-source blocks remain in force until unblocked.
--unblock removes both whole-source and TCP 80/443 blocks for the exact CIDR.
ACCESS_LOG overrides the default log; rotated numbered/date logs are included.
Default: /var/log/nginx/access.log (all hosts and redirects logged there).
The parser accepts the standard combined access-log format.
Dry-run checks allowlist and Googlebot protections (requires the crawler feed).
Rules are saved with netfilter-persistent when available; otherwise a warning
reports that this tool has not saved the changes for reboot.

Examples:
  $0 203.0.113.0/24
  $0 --list
  $0 --unblock 34.174.0.0/16 47.82.11.0/24
  $0 --autoblock 10 300 --dry-run
"

# Defaults
ACCESS_LOG_DEFAULT="${ACCESS_LOG:-/var/log/nginx/access.log}"
ALLOWLIST_FILE="${ALLOWLIST_FILE:-/etc/block_ip.allow}"
# Never blocked, regardless of the allowlist file
PROTECTED_CIDRS="127.0.0.0/8 ::1/128"

# Optional: ipinfo token to raise rate limits, export IPINFO_TOKEN=xxxxxxxx
IPINFO_TOKEN="${IPINFO_TOKEN:-}"

# Simple cache for IP geolocation lookups
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/busy_clients"
CACHE_FILE="$CACHE_DIR/ipinfo.tsv"

MODE="block"
FAMILY_LIST="all"
CHANGED=0
RULE_SCOPE="all"

ARG1="${1:-}"
ARG2="${2:-}"

if [ "${ARG1:-}" = "--list" ] || [ "${ARG1:-}" = "-l" ]; then
  [ "$#" -le 2 ] || { echo "$USAGE" >&2; exit 1; }
  MODE="list"
  case "${ARG2:-all}" in
    4|v4|ipv4) FAMILY_LIST="4" ;;
    6|v6|ipv6) FAMILY_LIST="6" ;;
    all|"") FAMILY_LIST="all" ;;
    *) echo "$USAGE" >&2; exit 1 ;;
  esac
elif [ "${ARG1:-}" = "--unblock" ] || [ "${ARG1:-}" = "-u" ]; then
  MODE="unblock"
  shift
  [ "$#" -ge 1 ] || { echo "$USAGE" >&2; exit 1; }
elif [ "${ARG1:-}" = "--autoblock" ]; then
  MODE="autoblock"
  shift
  [ "$#" -ge 2 ] || { echo "$USAGE" >&2; exit 1; }
  AB_MINUTES="$1"; AB_THRESHOLD="$2"; shift 2
  [[ "$AB_MINUTES" =~ ^[0-9]+$ && "$AB_MINUTES" =~ [1-9] && "$AB_THRESHOLD" =~ ^[0-9]+$ && "$AB_THRESHOLD" =~ [1-9] ]] \
    || { echo "Error: minutes and threshold must be positive integers" >&2; exit 1; }
  AB_DRY_RUN=0
  RULE_SCOPE="web"
  ACCESS_LOG="$ACCESS_LOG_DEFAULT"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) AB_DRY_RUN=1 ;;
      --all-ports) RULE_SCOPE="all" ;;
      --log) shift; ACCESS_LOG="${1:-}"; [ -n "$ACCESS_LOG" ] || { echo "Error: --log requires a path" >&2; exit 1; } ;;
      *) echo "Error: unknown flag for --autoblock: $1" >&2; echo "$USAGE" >&2; exit 1 ;;
    esac
    shift || true
  done
elif [ "${ARG1:-}" = "--help" ] || [ "${ARG1:-}" = "-h" ]; then
  echo "$USAGE"
  exit 0
else
  [ "$#" -eq 1 ] || { echo "$USAGE" >&2; exit 1; }
fi

# Resolve a binary even if not on PATH, trying common sbin locations
find_cmd() {
  local name="$1"
  local c
  if c=$(command -v "$name" 2>/dev/null); then
    echo "$c"
    return 0
  fi
  for c in "/usr/sbin/$name" "/sbin/$name"; do
    if [ -x "$c" ]; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

# Reverse DNS for a single IP, returns "(unresolved)" on failure
ptr_name() {
  local ip="$1" name=""
  if command -v host >/dev/null 2>&1; then
    name=$(host "$ip" 2>/dev/null | awk '/domain name pointer/ {print $5}' | sed 's/\.$//' | head -n1) || name=""
  fi
  if [ -z "$name" ] && command -v getent >/dev/null 2>&1; then
    name=$(getent hosts "$ip" 2>/dev/null | awk '{print $2}' | head -n1) || name=""
  fi
  if [ -z "$name" ] && command -v dig >/dev/null 2>&1; then
    name=$(dig +short -x "$ip" 2>/dev/null | sed 's/\.$//' | head -n1) || name=""
  fi
  [ -z "$name" ] && name="(unresolved)"
  printf '%s' "$name"
}

# All addresses a hostname resolves to, one per line
forward_addrs() {
  local name="$1"
  if command -v getent >/dev/null 2>&1; then
    getent ahosts "$name" 2>/dev/null | awk '{print $1}' | sort -u || true
  elif command -v dig >/dev/null 2>&1; then
    { dig +short A "$name"; dig +short AAAA "$name"; } 2>/dev/null | grep -v '\.$' || true
  fi
}

# Reverse DNS name for an IP, only if that name resolves back to the same IP.
# Without the forward check, whoever controls the IP's PTR record picks the name.
verified_ptr_name() {
  local ip="$1" name addrs
  name=$(ptr_name "$ip")
  [ "$name" = "(unresolved)" ] && return 1
  addrs=$(forward_addrs "$name")
  # Compare addresses semantically (IPv6 has multiple equivalent spellings).
  python3 - "$ip" "$addrs" <<'PY' || return 1
import ipaddress, sys
target = ipaddress.ip_address(sys.argv[1])
for item in sys.argv[2].splitlines():
    try:
        if ipaddress.ip_address(item) == target:
            sys.exit(0)
    except ValueError:
        pass
sys.exit(1)
PY
  printf '%s' "$name"
}

warn_if_no_allowlist() {
  [ -f "$ALLOWLIST_FILE" ] \
    || echo "Warning: allowlist $ALLOWLIST_FILE not found, only built-in and Googlebot protections apply" >&2
}

# Return 0 if a normalized CIDR must not be blocked, setting PROTECT_REASON.
# Address entries in $ALLOWLIST_FILE (and $PROTECTED_CIDRS) protect any range
# that overlaps them. Hostname globs are checked against forward-confirmed rDNS,
# which only exists for a single address, so they never protect a wider range.
PROTECT_REASON=""
is_protected() {
  local cidr="$1" fam="$2" out kind val host=""
  PROTECT_REASON=""
  out=$(
    python3 - "$cidr" "$ALLOWLIST_FILE" $PROTECTED_CIDRS <<'PY'
import sys, ipaddress
target = ipaddress.ip_network(sys.argv[1], strict=False)

def overlaps(entry):
    try:
        net = ipaddress.ip_network(entry, strict=False)
    except ValueError:
        return None
    return net.version == target.version and net.overlaps(target)

for entry in sys.argv[3:]:
    if overlaps(entry):
        print(f"match\t{entry} (built-in)")
        sys.exit(0)

globs = []
try:
    with open(sys.argv[2], "r", encoding="utf-8") as fh:
        for line in fh:
            entry = line.split("#", 1)[0].strip()
            if not entry:
                continue
            hit = overlaps(entry)
            if hit:
                print(f"match\t{entry}")
                sys.exit(0)
            if hit is None:
                globs.append(entry)
except FileNotFoundError:
    pass
for g in globs:
    print(f"glob\t{g}")
PY
  ) || { echo "Error: allowlist check failed for $cidr" >&2; exit 1; }

  while IFS=$'\t' read -r kind val; do
    case "$kind" in
      match)
        PROTECT_REASON="allowlist entry $val"
        return 0
        ;;
      glob)
        if [ -z "$host" ]; then
          { [ "$fam" = "4" ] && [[ "$cidr" == */32 ]]; } \
            || { [ "$fam" = "6" ] && [[ "$cidr" == */128 ]]; } \
            || return 1
          host=$(verified_ptr_name "${cidr%/*}") || return 1
          host="${host,,}"
        fi
        case "$host" in
          ${val,,}) PROTECT_REASON="rDNS $host matches $val"; return 0 ;;
        esac
        ;;
    esac
  done <<< "$out"
  return 1
}

# Lookup helper: returns "City, CC" or "(unknown)" for a single IP
lookup_geo() {
  local ip="$1"
  local cached
  cached=$(awk -v ip="$ip" -F'\t' '$1==ip {print $2; exit}' "$CACHE_FILE" 2>/dev/null) || cached=""
  if [ -n "$cached" ]; then
    printf "%s" "$cached"
    return 0
  fi
  local url="https://ipinfo.io/${ip}"
  if [ -n "$IPINFO_TOKEN" ]; then
    url="${url}?token=${IPINFO_TOKEN}"
  fi

  local resp out
  resp=$(curl -m 4 --retry 1 --retry-delay 1 -sS "$url") || resp=""
  out=$(python3 - "$resp" <<'PY'
import json, sys
try:
    data = json.loads(sys.argv[1])
    values = [data.get(key) for key in ('city', 'country')]
    print(', '.join(' '.join(v.split()) for v in values if isinstance(v, str) and v.strip()))
except (ValueError, AttributeError):
    pass
PY
  ) || out=""
  # Lookup failures must not prevent listing firewall rules or poison the cache.
  if [ -z "$out" ]; then
    printf '%s' '(unknown)'
    return 0
  fi
  if mkdir -p "$CACHE_DIR" && touch "$CACHE_FILE"; then
    printf "%s\t%s\n" "$ip" "$out" >> "$CACHE_FILE" || true
  fi
  printf "%s" "$out"
}

# List currently blocked source CIDRs on INPUT for the given family
list_family() {
  local base="$1"
  local label="$2"
  local cmd run width geo_width=24

  echo "$label"

  if ! cmd="$(find_cmd "$base")"; then
    echo "Error: $base not found, ensure /usr/sbin and /sbin are in PATH" >&2
    return 1
  fi

  if [ "${EUID:-$(id -u)}" -ne 0 ] && command -v sudo >/dev/null 2>&1; then
    run=(sudo -n "$cmd")
  else
    run=("$cmd")
  fi

  local lines rules
  rules=$("${run[@]}" -w 5 -S INPUT) || {
    echo "Error: cannot read $base INPUT rules (try sudo)" >&2
    return 1
  }
  lines=$(
    awk '
          $1=="-A" && $2=="INPUT" {
            src=""; drop=0; scope=""
            for (i=3; i<=NF; i++) {
              if ($i=="-s" && i+1<=NF) {src=$(++i); continue}
              if ($i=="-j" && i+1<=NF && $(i+1)=="DROP") {drop=1; i++; continue}
              scope=scope (scope=="" ? "" : " ") $i
            }
            if (drop && src!="") print src "\t" (scope=="" ? "all traffic" : scope)
          }
        ' <<< "$rules" | sort -u
  )

  width=22
  [ "$base" = "ip6tables" ] && width=46

  if [ -n "${lines:-}" ]; then
    local count=0
    # Header
    printf "  %-*s   %-*s %-30s %s\n" "$width" "CIDR" "$geo_width" "city,country" "hostname" "rule scope (additional matches)"
    printf "  %-*s   %-*s %s\n" "$width" "$(printf '%0.s-' $(seq 1 $width))" "$geo_width" "$(printf '%0.s-' $(seq 1 $geo_width))" "$(printf '%0.s-' $(seq 1 16))"
    local cidr scope
    while IFS=$'\t' read -r cidr scope; do
      [ -z "$cidr" ] && continue
      local hostcol="" geocol="(range)"
      if [ "$base" = "iptables" ] && [[ "$cidr" == */32 ]]; then
        local ip="${cidr%/*}"
        hostcol=$(ptr_name "$ip")
        geocol=$(lookup_geo "$ip")
      elif [ "$base" = "ip6tables" ] && [[ "$cidr" == */128 ]]; then
        local ip6="${cidr%/*}"
        hostcol=$(ptr_name "$ip6")
        geocol=$(lookup_geo "$ip6")
      fi
      printf "  %-*s   %-*s %-30s %s\n" "$width" "$cidr" "$geo_width" "$geocol" "$hostcol" "$scope"
      count=$((count+1))
    done <<< "$lines"
    echo "  -- total: $count"
  else
    echo "  (none)"
  fi
}

list_blocked() {
  if [ "$FAMILY_LIST" = "4" ] || [ "$FAMILY_LIST" = "all" ]; then
    list_family iptables "IPv4:"
  fi
  if [ "$FAMILY_LIST" = "6" ] || [ "$FAMILY_LIST" = "all" ]; then
    list_family ip6tables "IPv6:"
  fi
}

# Normalize an address to CIDR and return "CIDR FAMILY"
normalize_cidr() {
  python3 - "$1" <<'PY'
import sys, ipaddress
arg = sys.argv[1]
try:
    net = ipaddress.ip_network(arg, strict=False)
except ValueError:
    print("INVALID INVALID")
    sys.exit(0)
print(str(net), net.version)
PY
}

# Googlebot ranges cache
load_googlebot_json() {
  [ -n "$TMP_JSON" ] && return 0

  TMP_JSON="$(mktemp)"

  if ! curl \
    -fsSL \
    --connect-timeout 5 \
    --max-time 20 \
    --retry 3 \
    --retry-delay 1 \
    https://developers.google.com/crawling/ipranges/common-crawlers.json \
    -o "$TMP_JSON"; then
    echo "Error: failed to download Googlebot IP ranges" >&2
    exit 1
  fi

  if [ ! -s "$TMP_JSON" ]; then
    echo "Error: Googlebot IP ranges response was empty" >&2
    exit 1
  fi

  if ! python3 - "$TMP_JSON" <<'PY'
import json
import ipaddress
import sys

path = sys.argv[1]

try:
    with open(path, "r", encoding="utf-8") as fh:
        data = json.load(fh)
except (OSError, json.JSONDecodeError) as exc:
    print(f"Invalid Googlebot JSON: {exc}", file=sys.stderr)
    sys.exit(1)

try:
    if not isinstance(data, dict) or not isinstance(data.get("prefixes"), list) or not data['prefixes']:
        raise ValueError('missing or empty prefixes array')
    families = set()
    for entry in data['prefixes']:
        if not isinstance(entry, dict):
            raise ValueError('prefix entry must be an object')
        keys = [key for key in ('ipv4Prefix', 'ipv6Prefix') if key in entry]
        if len(keys) != 1:
            raise ValueError('entry must contain exactly one address prefix')
        key = keys[0]
        value = entry[key]
        if not isinstance(value, str):
            raise ValueError('prefix must be a string')
        net = ipaddress.ip_network(value)
        if net.version != (4 if key == 'ipv4Prefix' else 6):
            raise ValueError('prefix family does not match its key')
        families.add(net.version)
    if families != {4, 6}:
        raise ValueError('expected both IPv4 and IPv6 protection ranges')
except ValueError as exc:
    print(f'Invalid Googlebot JSON: {exc}', file=sys.stderr)
    sys.exit(1)
PY
  then
    echo "Error: downloaded Googlebot IP ranges are invalid" >&2
    exit 1
  fi
}

# Returns 0 if CIDR overlaps Googlebot ranges for given family (4 or 6)
cidr_is_googlebot() {
  local cidr="$1" fam="$2"
  [ -n "$TMP_JSON" ] || load_googlebot_json
  local ans
  ans=$(
    python3 - "$cidr" "$fam" "$TMP_JSON" <<'PY'
import sys, json, ipaddress
cidr = ipaddress.ip_network(sys.argv[1], strict=False)
fam  = int(sys.argv[2])
with open(sys.argv[3], 'r', encoding='utf-8') as fh:
    data = json.load(fh)
for p in data.get("prefixes", []):
    key = "ipv4Prefix" if fam == 4 else "ipv6Prefix"
    val = p.get(key)
    if not val:
        continue
    if cidr.overlaps(ipaddress.ip_network(val)):
        print("YES")
        break
else:
    print("NO")
PY
  ) || { echo "Error: Googlebot protection check failed for $cidr" >&2; return 2; }
  [ "$ans" = "YES" ]
}

# Build the exact rule shared by insertion and removal.
rule_args() {
  RULE_ARGS=(-s "$1")
  if [ "$2" = "web" ]; then
    RULE_ARGS+=(-p tcp -m multiport --dports 80,443)
  fi
  RULE_ARGS+=(-j DROP)
}

firewall_cmd() {
  local base=iptables
  [ "$1" = "6" ] && base=ip6tables
  IPT=$(find_cmd "$base") || { echo "Error: $base not found" >&2; return 1; }
  # A failed -C alone cannot distinguish missing rules from an unreadable chain.
  "$IPT" -w 5 -S INPUT >/dev/null || { echo "Error: cannot read $base INPUT chain" >&2; return 1; }
}

# Return 0 if present, 1 if absent, 2 on a firewall error.
rule_exists() {
  local status
  if "$IPT" -w 5 -C INPUT "${RULE_ARGS[@]}" 2>/dev/null; then
    return 0
  else
    status=$?
    [ "$status" -eq 1 ] && return 1
    echo "Error: firewall rule check failed (exit $status)" >&2
    return 2
  fi
}

# Insert DROP if missing; explicitly handle errors even when called in an if.
ensure_drop_rule() {
  local cidr="$1" fam="$2"
  RULE_ADDED=0
  firewall_cmd "$fam" || return 1
  rule_args "$cidr" "$RULE_SCOPE"
  if rule_exists; then
    echo "Rule already present: $cidr ($RULE_SCOPE) via $IPT"
    return 0
  else
    [ "$?" -eq 1 ] || return 1
  fi
  if "$IPT" -w 5 -I INPUT "${RULE_ARGS[@]}"; then
    echo "Blocked IP range: $cidr ($RULE_SCOPE) via $IPT"
    CHANGED=1
    RULE_ADDED=1
  else
    echo "Error: failed to block $cidr" >&2
    return 1
  fi
}

# Delete exact whole-source and web-only rules, including duplicates.
delete_block() {
  local cidr="$1" fam="$2" scope removed=0
  firewall_cmd "$fam" || return 1
  for scope in all web; do
    rule_args "$cidr" "$scope"
    while true; do
      if rule_exists; then
        if ! "$IPT" -w 5 -D INPUT "${RULE_ARGS[@]}"; then
          echo "Error: failed to remove $cidr ($scope); removed $removed rule(s) so far" >&2
          return 1
        fi
        CHANGED=1
        removed=$((removed+1))
      else
        [ "$?" -eq 1 ] || return 1
        break
      fi
    done
  done
  if [ "$removed" -gt 0 ]; then
    echo "Unblocked $cidr via $IPT, removed $removed rule(s)"
  else
    echo "No matching DROP rule found for $cidr on $IPT"
  fi
}

save_changes() {
  [ "$CHANGED" -eq 1 ] || return 0
  local saver
  if saver=$(find_cmd netfilter-persistent); then
    "$saver" save || { echo "Error: live rules changed but saving them failed" >&2; return 1; }
  else
    echo "Warning: live rules changed but netfilter-persistent is unavailable; this tool has not saved them for reboot" >&2
  fi
}

# Autoblock: print "count ip" lines for offenders, one per line
autoblock_candidates() {
  local logpath="$1" minutes="$2" threshold="$3"
  python3 - "$logpath" "$minutes" "$threshold" <<'PY'
import sys, re, glob, gzip, ipaddress, os
from datetime import datetime, timezone, timedelta
path, minutes, thr = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
now = datetime.now(timezone.utc)
try:
    cutoff = now - timedelta(minutes=minutes)
except OverflowError:
    print('Error: minutes exceeds the supported time range', file=sys.stderr)
    sys.exit(1)

pat = re.compile(r'^(\S+).*?\[([^\]]+)\]')
counts, seen = {}, set()
rotation = re.compile(r'(?:\.\d+|-\d{8}(?:-\d{6})?)(?:\.gz)?$')
paths = [path] + sorted(p for p in glob.glob(glob.escape(path) + '*')
                        if rotation.fullmatch(p[len(path):]))
try:
    for filename in paths:
        stat = os.stat(filename)
        identity = (stat.st_dev, stat.st_ino)
        if identity in seen:
            continue
        seen.add(identity)
        if filename != path and stat.st_mtime < cutoff.timestamp():
            continue
        opener = gzip.open if filename.endswith('.gz') else open
        with opener(filename, 'rt', errors='replace') as f:
            for line in f:
                m = pat.search(line)
                if not m:
                    continue
                try:
                    ip = str(ipaddress.ip_address(m.group(1)))
                    dt = datetime.strptime(m.group(2), '%d/%b/%Y:%H:%M:%S %z')
                except ValueError:
                    continue
                if cutoff <= dt <= now:
                    counts[ip] = counts.get(ip, 0) + 1
except (OSError, EOFError) as exc:
    print(f'Error: cannot scan access logs: {exc}', file=sys.stderr)
    sys.exit(1)

for ip, c in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0])):
  if c >= thr:
    print(f"{c} {ip}")
PY
}

if [ "$MODE" = "list" ]; then
  list_blocked
  exit 0
fi

if [ "$MODE" = "unblock" ]; then
  if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    echo "Error: must be run as root" >&2
    exit 1
  fi
  failed=0
  for arg in "$@"; do
    read -r CIDR FAMILY <<<"$(normalize_cidr "$arg")"
    if [ "$CIDR" = "INVALID" ]; then
      echo "Error: invalid IP or CIDR: $arg" >&2
      failed=1
      continue
    fi
    delete_block "$CIDR" "$FAMILY" || failed=1
  done
  save_changes || failed=1
  exit "$failed"
fi

if [ "$MODE" = "autoblock" ]; then
  [ -f "$ACCESS_LOG" ] || { echo "Error: access log not found at $ACCESS_LOG" >&2; exit 1; }

  echo "Scanning $ACCESS_LOG for last $AB_MINUTES minute(s), threshold >= $AB_THRESHOLD"
  offenders="$(autoblock_candidates "$ACCESS_LOG" "$AB_MINUTES" "$AB_THRESHOLD")" || exit 1
  if [ -z "$offenders" ]; then
    echo "No offenders found"
    exit 0
  fi

  echo "Candidates:"
  while read -r c ip; do printf '  %s %s\n' "$c" "$ip"; done <<< "$offenders"

  if [ "$AB_DRY_RUN" -eq 0 ] && [ "${EUID:-$(id -u)}" -ne 0 ]; then
    echo "Error: must be run as root to block" >&2
    exit 1
  fi

  warn_if_no_allowlist
  load_googlebot_json

  # Finish every protection check before applying any changes.
  planned=() skipped=0
  while read -r c ip; do
    [ -z "$ip" ] && continue

    read -r CIDR FAMILY <<<"$(normalize_cidr "$ip")"
    if [ "$CIDR" = "INVALID" ]; then
      echo "Skip invalid: $ip"
      skipped=$((skipped+1))
      continue
    fi

    if is_protected "$CIDR" "$FAMILY"; then
      echo "Skip protected: $ip ($c hits, $PROTECT_REASON)"
      skipped=$((skipped+1))
      continue
    fi

    if cidr_is_googlebot "$CIDR" "$FAMILY"; then
      echo "Skip Googlebot: $ip ($c hits)"
      skipped=$((skipped+1))
      continue
    else
      [ "$?" -eq 1 ] || exit 1
    fi

    planned+=("$CIDR $FAMILY")
    if [ "$AB_DRY_RUN" -eq 1 ]; then
      echo "Would block: $ip ($c hits, scope: $RULE_SCOPE)"
    fi
  done <<<"$offenders"

  if [ "$AB_DRY_RUN" -eq 1 ]; then
    echo "(dry run) Would block: ${#planned[@]}, Skipped: $skipped. No firewall changes made"
    exit 0
  fi

  blocked=0 existing=0 failed=0
  for candidate in "${planned[@]}"; do
    read -r CIDR FAMILY <<< "$candidate"
    if ensure_drop_rule "$CIDR" "$FAMILY"; then
      if [ "$RULE_ADDED" -eq 1 ]; then
        blocked=$((blocked+1))
      else
        existing=$((existing+1))
      fi
    else
      failed=$((failed+1))
    fi
  done
  result=0
  [ "$failed" -eq 0 ] || result=1
  save_changes || result=1
  echo "Autoblock complete. Blocked: $blocked, Already present: $existing, Skipped: $skipped, Failed: $failed"
  exit "$result"
fi

# Blocking mode from here on

ARG="${ARG1:-}"
[ -n "$ARG" ] || { echo "$USAGE" >&2; exit 1; }

if [ "${EUID:-$(id -u)}" -ne 0 ]; then
  echo "Error: must be run as root" >&2
  exit 1
fi

read -r CIDR FAMILY <<EOF
$(normalize_cidr "$ARG")
EOF

if [ "$CIDR" = "INVALID" ]; then
  echo "Error: invalid IP or CIDR: $ARG" >&2
  exit 1
fi

warn_if_no_allowlist
if is_protected "$CIDR" "$FAMILY"; then
  echo "Range $CIDR is protected ($PROTECT_REASON), skipping block"
  exit 0
fi

load_googlebot_json
if cidr_is_googlebot "$CIDR" "$FAMILY"; then
  echo "Range $CIDR overlaps Googlebot, skipping block"
  exit 0
else
  [ "$?" -eq 1 ] || exit 1
fi

ensure_drop_rule "$CIDR" "$FAMILY"

save_changes


