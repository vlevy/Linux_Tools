#!/bin/bash

# Override the Nginx log path and robots source through the environment.
# A supplied local ROBOTS_FILE takes precedence over downloading ROBOTS_URL.
ROBOTS_FILE="${ROBOTS_FILE:-}"
ROBOTS_URL="${ROBOTS_URL:-https://www.pianyc.net/robots.txt}"
ACCESS_LOG="${ACCESS_LOG:-/var/log/nginx/access.log}"
ALLOWLIST_FILE="${ALLOWLIST_FILE:-/etc/block_ip.allow}"

# Optional: ipinfo token to raise rate limits, export IPINFO_TOKEN=xxxxxxxx
IPINFO_TOKEN="${IPINFO_TOKEN:-}"

# Simple cache to reduce external lookups
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/busy_clients"
CACHE_FILE="$CACHE_DIR/ipinfo.tsv"
mkdir -p "$CACHE_DIR"
touch "$CACHE_FILE"

# Usage helper
usage() {
  cat <<'EOF'
busy_clients [--list] [--sort total|disallowed] [DAYS]

Without flags, prints a formatted table of IPs with totals, disallowed counts, status,
city,country, and hostname.
--list prints a machine-friendly list with the same columns in a single line per IP.
--sort total sorts by total requests descending.
--sort disallowed sorts by disallowed requests descending, then total descending (the default).
If DAYS is omitted, defaults to 7. Rotated logs (access.log.1, access.log.2.gz, ...) are read too.
The default log includes all hosts and redirects logged by this Nginx server.

Environment overrides:
  ACCESS_LOG   Current access-log file (rotated copies are discovered automatically).
               Default: /var/log/nginx/access.log
  ROBOTS_FILE  Optional local robots.txt file, used instead of downloading ROBOTS_URL.
  ROBOTS_URL   robots.txt URL fetched once per run when ROBOTS_FILE is not supplied.
               Default: https://www.pianyc.net/robots.txt
               Download requires HTTP 200 and a robots.txt User-agent directive.
  ALLOWLIST_FILE  block_ip allowlist. Default: /etc/block_ip.allow

disallowed: requests of any method to paths robots.txt disallows for "User-agent: *",
            honoring Allow: lines and * / $ wildcards.
status:     blocked if the IP matches a source CIDR in a direct INPUT DROP rule;
            protected if it matches the block_ip allowlist, loopback, or official
            Googlebot prefixes; open otherwise. An existing block takes precedence
            over protection, because adding an exception does not remove a rule.
            Hostname globs require forward-confirmed reverse DNS, as in block_ip.
            Status requires readable IPv4/IPv6 rules and allowlist, and a valid
            Googlebot feed; failures stop the report rather than showing open.
            Firewall matching is not a complete effective-block check:
            rule order, extra match conditions, chain policies, other chains,
            native nftables rules, AWS rules and application blocks are not evaluated.
            Root or passwordless sudo may be needed to read these rules.
EOF
}

# Mode and days parsing
MODE="table"
DAYS_BACK=""
SORT_BY="disallowed"
while [ "$#" -gt 0 ]; do
case "$1" in
  --help|-h)
    usage
    exit 0
    ;;
  --list)
    MODE="list"
    ;;
  --sort)
    if [[ "${2:-}" != "total" && "${2:-}" != "disallowed" ]]; then
      echo "Error: --sort requires total or disallowed" >&2
      exit 1
    fi
    SORT_BY="$2"
    shift
    ;;
  *)
    if [[ -n "$DAYS_BACK" ]]; then
      echo "Error: Unexpected argument: $1" >&2
      exit 1
    fi
    DAYS_BACK="$1"
    ;;
esac
shift
done
DAYS_BACK="${DAYS_BACK:-7}"
if ! [[ "$DAYS_BACK" =~ ^[1-9][0-9]*$ ]]; then
  echo "Error: DAYS must be a positive whole number, got: $DAYS_BACK" >&2
  usage >&2
  exit 1
fi

# Check the log before downloading robots.txt.
if [ ! -f "$ACCESS_LOG" ] || [ ! -r "$ACCESS_LOG" ]; then
  echo "Error: Access log not found or not readable at $ACCESS_LOG" >&2
  exit 1
fi

# Keep downloaded rules and intermediate files private and remove them on exit.
WORK_DIR=$(mktemp -d) || exit 1
BLOCKED="$WORK_DIR/blocked"
MERGED="$WORK_DIR/merged"

# Ensure cleanup
cleanup() {
  rm -rf -- "$WORK_DIR"
}
trap cleanup EXIT

if [ -n "$ROBOTS_FILE" ]; then
  if [ ! -f "$ROBOTS_FILE" ] || [ ! -r "$ROBOTS_FILE" ]; then
    echo "Error: robots.txt not found or not readable at $ROBOTS_FILE" >&2
    exit 1
  fi
else
  ROBOTS_FILE="$WORK_DIR/robots.txt"
  if ! robots_status=$(curl --silent --show-error --fail --location \
      --proto '=http,https' --proto-redir '=http,https' \
      --connect-timeout 5 --max-time 20 --max-redirs 5 \
      --output "$ROBOTS_FILE" --write-out '%{http_code}' "$ROBOTS_URL"); then
    echo "Error: Could not download robots.txt from $ROBOTS_URL" >&2
    exit 1
  fi
  if [ "$robots_status" != "200" ]; then
    echo "Error: robots.txt download returned HTTP $robots_status (expected 200)" >&2
    exit 1
  fi
  # Reject HTML/error pages rather than silently counting every request as allowed.
  if ! python3 - "$ROBOTS_FILE" <<'PY'
import re, sys
from pathlib import Path
text = Path(sys.argv[1]).read_text(encoding="utf-8-sig", errors="replace")
if "<html" in text.lower() or "<!doctype html" in text.lower():
    sys.exit(1)
sys.exit(0 if re.search(r"^\s*user-agent\s*:\s*[^\s#]+", text, re.I | re.M) else 1)
PY
  then
    echo "Error: Downloaded robots.txt is not a recognized robots file (expected a User-agent directive)" >&2
    exit 1
  fi
fi

# Resolve a binary even if not on PATH, trying common sbin locations
find_cmd() {
  local name="$1"
  local c
  if c=$(command -v "$name" 2>/dev/null); then
    echo "$c"
    return 0
  fi
  for c in "/usr/sbin/$name" "/sbin/$name"; do
    if [ -x "$c" ]; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

# Write source CIDRs of DROP rules on INPUT (IPv4 and IPv6) to a file.
# Returns 1 if either rule set can't be read.
read_blocked() {
  local out="$1" base cmd rules status=0
  local -a run
  : > "$out"
  for base in iptables ip6tables; do
    if ! cmd="$(find_cmd "$base")"; then
      status=1
      continue
    fi
    if [ "${EUID:-$(id -u)}" -ne 0 ] && command -v sudo >/dev/null 2>&1; then
      run=(sudo -n "$cmd")
    else
      run=("$cmd")
    fi
    if ! rules=$("${run[@]}" -w 5 -S INPUT 2>/dev/null); then
      status=1
      continue
    fi
    printf '%s\n' "$rules" | awk '
      $1=="-A" && $2=="INPUT" {
        src=""; drop=0
        for (i=3; i<=NF; i++) {
          if ($i=="-s" && i+1<=NF) src=$(i+1)
          if ($i=="-j" && i+1<=NF && $(i+1)=="DROP") drop=1
        }
        if (drop && src!="") print src
      }
    ' >> "$out"
  done
  return $status
}

if ! read_blocked "$BLOCKED"; then
  echo "Error: cannot determine status: could not read both iptables/ip6tables INPUT rulesets; run with sudo or configure passwordless access" >&2
  exit 1
fi

if [ ! -f "$ALLOWLIST_FILE" ] || [ ! -r "$ALLOWLIST_FILE" ]; then
  echo "Error: cannot determine protection status: allowlist not found or unreadable at $ALLOWLIST_FILE" >&2
  exit 1
fi

GOOGLEBOT_FILE="$WORK_DIR/googlebot.json"
if ! curl --silent --show-error --fail --location --connect-timeout 5 --max-time 20 \
    --proto '=https' --proto-redir '=https' --output "$GOOGLEBOT_FILE" \
    https://developers.google.com/crawling/ipranges/common-crawlers.json; then
  echo "Error: cannot determine protection status: could not download Googlebot prefixes" >&2
  exit 1
fi

# Count requests and classify each IP using the same protection sources as block_ip.
python3 - "$ACCESS_LOG" "$ROBOTS_FILE" "$DAYS_BACK" "$BLOCKED" "$ALLOWLIST_FILE" "$GOOGLEBOT_FILE" > "$MERGED" <<'PY'
import fnmatch, functools, glob, gzip, ipaddress, json, os, re, subprocess, sys
from datetime import date, datetime, time, timedelta

log_path, robots_path, days, blocked_path = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]
allowlist_path, googlebot_path = sys.argv[5:7]

def protection_sources():
    protected = [ipaddress.ip_network('127.0.0.0/8'), ipaddress.ip_network('::1/128')]
    hostname_globs = []
    with open(allowlist_path, encoding='utf-8') as fh:
        for line in fh:
            entry = line.split('#', 1)[0].strip()
            if not entry:
                continue
            try:
                protected.append(ipaddress.ip_network(entry, strict=False))
            except ValueError:
                hostname_globs.append(entry.lower())
    with open(googlebot_path, encoding='utf-8') as fh:
        feed = json.load(fh)
    if not isinstance(feed, dict) or not isinstance(feed.get('prefixes'), list) or not feed['prefixes']:
        raise ValueError('missing or empty Googlebot prefixes array')
    families = set()
    for entry in feed['prefixes']:
        if not isinstance(entry, dict):
            raise ValueError('Googlebot prefix entry must be an object')
        keys = [key for key in ('ipv4Prefix', 'ipv6Prefix') if key in entry]
        if len(keys) != 1 or not isinstance(entry[keys[0]], str):
            raise ValueError('Googlebot entry must contain one address prefix string')
        key = keys[0]
        net = ipaddress.ip_network(entry[key])
        if net.version != (4 if key == 'ipv4Prefix' else 6):
            raise ValueError('Googlebot prefix family does not match key')
        protected.append(net)
        families.add(net.version)
    if families != {4, 6}:
        raise ValueError('expected both IPv4 and IPv6 Googlebot prefixes')
    return protected, hostname_globs

try:
    protected_nets, hostname_globs = protection_sources()
except (OSError, ValueError) as exc:
    print(f'Error: cannot determine protection status: {exc}', file=sys.stderr)
    sys.exit(1)

# robots.txt rules for "User-agent: *" (or every group if there is no * group),
# as (pattern length, is_allow, regex)
def load_rules(path):
    groups, agents, rules, in_rules = [], [], [], False
    with open(path, "r", encoding="utf-8", errors="ignore") as fh:
        for line in fh:
            line = line.split("#", 1)[0].strip()
            if ":" not in line:
                continue
            key, val = (s.strip() for s in line.split(":", 1))
            key = key.lower()
            if key == "user-agent":
                if in_rules:
                    groups.append((agents, rules))
                    agents, rules, in_rules = [], [], False
                agents.append(val.lower())
            elif key in ("allow", "disallow"):
                in_rules = True
                if val:  # an empty Disallow: means allow everything
                    rules.append((key == "allow", val))
    groups.append((agents, rules))

    if any("*" in a for a, _ in groups):
        chosen = [r for a, rs in groups if "*" in a for r in rs]
    else:
        chosen = [r for _, rs in groups for r in rs]

    compiled = []
    for allow, pat in chosen:
        anchored = pat.endswith("$")
        body = pat[:-1] if anchored else pat
        rx = ".*".join(re.escape(part) for part in body.split("*")) + ("$" if anchored else "")
        compiled.append((len(pat), allow, re.compile(rx)))
    return compiled

RULES = load_rules(robots_path)

# Longest matching rule wins, Allow wins a tie (Google's robots.txt semantics)
@functools.lru_cache(maxsize=200000)
def is_disallowed(path):
    best = None
    for length, allow, rx in RULES:
        if rx.match(path) and (best is None or length > best[0] or (length == best[0] and allow)):
            best = (length, allow)
    return best is not None and not best[1]

# Today and the previous days-1 days, in combined-log dd/Mon/yyyy form
first_day = date.today() - timedelta(days=days - 1)
day_strings = {(first_day + timedelta(days=i)).strftime("%d/%b/%Y") for i in range(days)}
window_start = datetime.combine(first_day, time.min).timestamp()

# Current log plus rotated copies (access_log.1, access_log.2.gz, access_log-20250901, ...),
# skipping any not written to since the window started
files = [log_path] + sorted(glob.glob(glob.escape(log_path) + "[.-]*"))
files = [f for f in files if os.path.isfile(f) and os.path.getmtime(f) >= window_start]

line_re = re.compile(r'^(\S+) \S+ \S+ \[(\d{2}/\w{3}/\d{4}):[^\]]*\] "([^"]*)"')
total, disallowed = {}, {}

for f in files:
    opener = gzip.open if f.endswith(".gz") else open
    try:
        with opener(f, "rt", errors="ignore") as fh:
            for line in fh:
                m = line_re.match(line)
                if not m or m.group(2) not in day_strings:
                    continue
                try:
                    ip = str(ipaddress.ip_address(m.group(1)))
                except ValueError:
                    continue
                total[ip] = total.get(ip, 0) + 1
                request = m.group(3).split()
                if len(request) >= 2 and is_disallowed(request[1]):
                    disallowed[ip] = disallowed.get(ip, 0) + 1
    except (OSError, EOFError) as exc:
        print(f"Warning: could not fully read {f}: {exc}", file=sys.stderr)

with open(blocked_path, encoding='utf-8') as fh:
    nets = [ipaddress.ip_network(line.strip(), strict=False) for line in fh if line.strip()]

def verified_hostname(ip):
    reverse = subprocess.run(['getent', 'hosts', ip], capture_output=True, text=True, timeout=5)
    if reverse.returncode != 0 or not reverse.stdout.strip():
        return None
    fields = reverse.stdout.splitlines()[0].split()
    if len(fields) < 2:
        return None
    name = fields[1].lower().rstrip('.')
    forward = subprocess.run(['getent', 'ahosts', name], capture_output=True, text=True, timeout=5)
    if forward.returncode != 0:
        return None
    target = ipaddress.ip_address(ip)
    for line in forward.stdout.splitlines():
        try:
            if ipaddress.ip_address(line.split()[0]) == target:
                return name
        except (ValueError, IndexError):
            pass
    return None

def client_status(ip):
    addr = ipaddress.ip_address(ip)
    # An allowlist exception prevents new blocks; it cannot override an old DROP.
    if any(addr in n for n in nets):
        return 'blocked'
    if any(addr in n for n in protected_nets):
        return 'protected'
    if hostname_globs:
        name = verified_hostname(ip)
        if name and any(fnmatch.fnmatchcase(name, pattern) for pattern in hostname_globs):
            return 'protected'
    return 'open'

try:
    for ip, count in total.items():
        print(ip, count, disallowed.get(ip, 0), client_status(ip))
except (OSError, subprocess.TimeoutExpired) as exc:
    print(f'Error: cannot verify hostname protection: {exc}', file=sys.stderr)
    sys.exit(1)
PY
[ $? -eq 0 ] || { echo "Error: failed to process $ACCESS_LOG" >&2; exit 1; }

# US state names, as ipinfo reports them in "region", to postal abbreviations
declare -A US_STATE_ABBR=(
  ["Alabama"]=AL ["Alaska"]=AK ["Arizona"]=AZ ["Arkansas"]=AR ["California"]=CA
  ["Colorado"]=CO ["Connecticut"]=CT ["Delaware"]=DE ["Florida"]=FL ["Georgia"]=GA
  ["Hawaii"]=HI ["Idaho"]=ID ["Illinois"]=IL ["Indiana"]=IN ["Iowa"]=IA
  ["Kansas"]=KS ["Kentucky"]=KY ["Louisiana"]=LA ["Maine"]=ME ["Maryland"]=MD
  ["Massachusetts"]=MA ["Michigan"]=MI ["Minnesota"]=MN ["Mississippi"]=MS ["Missouri"]=MO
  ["Montana"]=MT ["Nebraska"]=NE ["Nevada"]=NV ["New Hampshire"]=NH ["New Jersey"]=NJ
  ["New Mexico"]=NM ["New York"]=NY ["North Carolina"]=NC ["North Dakota"]=ND ["Ohio"]=OH
  ["Oklahoma"]=OK ["Oregon"]=OR ["Pennsylvania"]=PA ["Rhode Island"]=RI ["South Carolina"]=SC
  ["South Dakota"]=SD ["Tennessee"]=TN ["Texas"]=TX ["Utah"]=UT ["Vermont"]=VT
  ["Virginia"]=VA ["Washington"]=WA ["West Virginia"]=WV ["Wisconsin"]=WI ["Wyoming"]=WY
  ["District of Columbia"]=DC ["Washington, D.C."]=DC
)

# Extract a top-level string field from an ipinfo JSON response
json_field() {
  local resp="$1" key="$2"
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$resp" | jq -r ".${key} // empty" 2>/dev/null
  else
    printf '%s' "$resp" | tr -d '\r' | grep -o "\"${key}\":[[:space:]]*\"[^\"]*\"" | head -1 | sed "s/.*\"${key}\":[[:space:]]*\"\([^\"]*\)\".*/\1/"
  fi
}

# Lookup helper: returns "City, ST, US" for US IPs, "City, CC" otherwise, or "(unknown)"
lookup_geo() {
  local ip="$1"
  local cached
  # Newest entry wins, so a re-lookup below replaces an older cached value
  cached=$(awk -v ip="$ip" -F'\t' '$1==ip {v=$2} END {print v}' "$CACHE_FILE")
  # "City, US" entries predate the state column (block_ip still writes them), so look those up again
  if [ -n "$cached" ] && ! [[ "$cached" =~ ^[^,]+,\ US$ ]]; then
    printf "%s" "$cached"
    return 0
  fi

  local url="https://ipinfo.io/${ip}"
  if [ -n "$IPINFO_TOKEN" ]; then
    url="${url}?token=${IPINFO_TOKEN}"
  fi
  # echo "LOOKING UP URL"
  # echo ${url}

  local resp
  resp=$(curl -m 4 --retry 1 --retry-delay 1 -sS "$url") || resp=""

  local city region country
  city=$(json_field "$resp" city)
  region=$(json_field "$resp" region)
  country=$(json_field "$resp" country)

  # For US IPs, put the state between city and country
  if [ "$country" = "US" ] && [ -n "$region" ]; then
    country="${US_STATE_ABBR[$region]:-$region}, US"
  fi

  local out
  if [ -n "$city" ] && [ -n "$country" ]; then
    out="${city}, ${country}"
  elif [ -n "$country" ]; then
    out="${country}"
  elif [ -n "$city" ]; then
    out="${city}"
  else
    out="(unknown)"
  fi

  # Lookup failed, keep any older cached value rather than caching "(unknown)" over it
  if [ "$out" = "(unknown)" ] && [ -n "$cached" ]; then
    printf "%s" "$cached"
    return 0
  fi

  printf "%s\t%s\n" "$ip" "$out" >> "$CACHE_FILE"
  printf "%s" "$out"
}

# Hostname helper
lookup_host() {
  local ip="$1"
  local h
  h=$(host "$ip" 2>/dev/null | awk "/domain name pointer/ {print \$5}" | sed 's/\.$//')
  [ -z "$h" ] && h="(unresolved)"
  printf "%s" "$h"
}

# Sort both output formats using the same ordering, with IP as a stable final tie-breaker.
SORT_KEYS=(-k2,2nr -k1,1)
if [ "$SORT_BY" = "disallowed" ]; then
  SORT_KEYS=(-k3,3nr -k2,2nr -k1,1)
fi

# Output
if [ "$MODE" = "list" ]; then
  # Machine friendly list, one line per IP, includes city,country
  # Columns: ip total disallowed status city,country hostname
  sort "${SORT_KEYS[@]}" "$MERGED" | while read -r ip total disallowed status; do
    geo="$(lookup_geo "$ip")"
    hostn="$(lookup_host "$ip")"
    printf "%s\t%s\t%s\t%s\t%s\t%s\n" "$ip" "$total" "$disallowed" "$status" "$geo" "$hostn"
  done
  exit 0
fi

echo
echo "=== Clients in the past $DAYS_BACK days (total vs disallowed) ==="
printf "%-39s %7s %11s %9s   %-24s %s\n" "IP" "total" "disallowed" "status" "city,country" "hostname"
printf "%-39s %7s %11s %9s   %-24s %s\n" "---------------------------------------" "------" "-----------" "---------" "------------" "--------"

sort "${SORT_KEYS[@]}" "$MERGED" | while read -r ip total disallowed status; do
  hostname="$(lookup_host "$ip")"
  geo="$(lookup_geo "$ip")"
  printf "%-39s %7s %11s %9s   %-24s %s\n" "$ip" "$total" "$disallowed" "$status" "$geo" "$hostname"
done

echo
echo "Total unique IPs: $(wc -l < "$MERGED")"
echo "Unique IPs with disallowed accesses: $(awk '$3 > 0' "$MERGED" | wc -l)"
echo "Status: blocked takes precedence over protected, then open; see --help for matching limits."

